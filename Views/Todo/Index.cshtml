@model List<TodoApp.Models.TodoItem>
@{
    ViewData["Title"] = "Task-urile mele";
    var pending = Model.Where(t => !t.IsComplete).ToList();
    var completed = Model.Where(t => t.IsComplete).ToList();
}

<div class="todo-page">
    <div class="todo-header">
        <h1>Task-urile mele</h1>
        <p class="todo-subtitle">@pending.Count ramase, @completed.Count finalizate</p>
    </div>

    <div class="add-form">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="form-row">
                <input type="text" name="title" placeholder="Adauga un task nou..." class="form-input" required autofocus />
            </div>
            <div class="form-row" style="margin-bottom:0">
                <input type="text" name="description" placeholder="Descriere (optional)..." class="form-input" />
                <input type="date" name="dueDate" class="form-input form-input-date" />
                <button type="submit" class="btn btn-primary">+ Adauga</button>
            </div>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">✓</div>
            <p>Niciun task inca. Adauga primul tau task!</p>
        </div>
    }
    else
    {
        @if (pending.Any())
        {
            <div class="todo-section">
                <h2 class="section-title">De facut (@pending.Count)</h2>
                <ul class="todo-list">
                    @foreach (var item in pending)
                    {
                        <li class="todo-item">
                            <form asp-action="Toggle" method="post" style="display:inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="todo-check" title="Marcheaza ca finalizat">○</button>
                            </form>
                            <div class="todo-text">
                                <span class="todo-title">@item.Title</span>
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <span class="todo-desc">@item.Description</span>
                                }
                            </div>
                            @if (item.DueDate.HasValue)
                            {
                                <span class="todo-date">📅 @item.DueDate.Value.ToString("dd MMM yyyy")</span>
                            }
                            <form asp-action="Delete" method="post" style="display:inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="todo-delete" title="Sterge" onclick="return confirm('Sigur?')">✕</button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
        }

        @if (completed.Any())
        {
            <div class="todo-section">
                <h2 class="section-title completed-title">Finalizate (@completed.Count)</h2>
                <ul class="todo-list">
                    @foreach (var item in completed)
                    {
                        <li class="todo-item todo-item-done">
                            <form asp-action="Toggle" method="post" style="display:inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="todo-check todo-check-done" title="Marcheaza ca nefinalizat">✓</button>
                            </form>
                            <div class="todo-text">
                                <span class="todo-title">@item.Title</span>
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <span class="todo-desc">@item.Description</span>
                                }
                            </div>
                            @if (item.DueDate.HasValue)
                            {
                                <span class="todo-date">📅 @item.DueDate.Value.ToString("dd MMM yyyy")</span>
                            }
                            <form asp-action="Delete" method="post" style="display:inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="todo-delete" title="Sterge" onclick="return confirm('Sigur?')">✕</button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
        }
    }
</div>