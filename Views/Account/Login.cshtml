@model TodoApp.Models.LoginViewModel
@{
    ViewData["Title"] = "Autentificare";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <span class="auth-icon">✓</span>
            <h1>TodoApp</h1>
            <p>Autentifica-te pentru a continua</p>
        </div>

        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="validation-summary"></div>
            }

            <div class="form-group">
                <label asp-for="Username">Nume utilizator</label>
                <input asp-for="Username" class="form-input" placeholder="ex: admin" autofocus />
            </div>

            <div class="form-group">
                <label asp-for="Password">Parola</label>
                <input asp-for="Password" type="password" class="form-input" placeholder="••••••" />
            </div>

            <div class="form-group form-check">
                <input asp-for="RememberMe" type="checkbox" />
                <label asp-for="RememberMe">Tine-ma minte</label>
            </div>

            <button type="submit" class="btn btn-primary btn-full">Autentificare</button>
        </form>

        <div class="auth-footer">
            Nu ai cont? <a asp-controller="Account" asp-action="Register">Inregistreaza-te</a>
        </div>
    </div>
</div>
