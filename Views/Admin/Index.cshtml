@{
    ViewData["Title"] = "Panou Admin";
    var users = ViewBag.Users as List<Microsoft.AspNetCore.Identity.IdentityUser>;
}

<div class="admin-page">
    <div class="todo-header">
        <h1>Panou Admin</h1>
        <p class="todo-subtitle">Gestioneaza utilizatorii si task-urile</p>
    </div>

    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-number">@(users?.Count ?? 0)</div>
            <div class="stat-label">Utilizatori</div>
        </div>
        <div class="stat-card">
            <div class="stat-number">@ViewBag.TotalTodos</div>
            <div class="stat-label">Total task-uri</div>
        </div>
        <div class="stat-card">
            <div class="stat-number">@ViewBag.CompletedTodos</div>
            <div class="stat-label">Finalizate</div>
        </div>
    </div>

    <div class="todo-section">
        <h2 class="section-title">Utilizatori</h2>
        <ul class="todo-list">
            @foreach (var user in users ?? new List<Microsoft.AspNetCore.Identity.IdentityUser>())
            {
                <li class="todo-item">
                    <div class="todo-text">
                        <span class="todo-title">@user.UserName</span>
                        <span class="todo-desc">@user.Email</span>
                    </div>
                    @if (user.UserName != "admin")
                    {
                        <form asp-action="DeleteUser" method="post" style="display:inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@user.Id" />
                            <button type="submit" class="btn btn-secondary btn-sm" onclick="return confirm('Stergi utilizatorul @user.UserName?')">Sterge</button>
                        </form>
                    }
                </li>
            }
        </ul>
    </div>
</div>
